{
  "schemaVersion": "lionroot.fleetRecipes.v1",
  "recipes": [
    {
      "name": "rtx-5090-vllm",
      "match": { "machineId": "dadspowerspec" },
      "backend": "vllm",
      "models": [
        {
          "id": "qwen3.6:35b-a3b",
          "launch": {
            "engine": "vllm",
            "model": "Qwen/Qwen3.5-35B-A3B",
            "tensorParallelSize": 1,
            "gpuMemoryUtilization": 0.85,
            "maxModelLen": 32768
          }
        }
      ]
    },
    {
      "name": "gaming-pc-ollama",
      "match": { "machineId": ["daddyo-gaming", "daughter-gaming", "son-gaming"] },
      "backend": "ollama",
      "models": [
        {
          "id": "gemma4:e2b",
          "launch": {
            "engine": "ollama",
            "model": "gemma4:e2b"
          }
        }
      ]
    },
    {
      "name": "mac-mini-mlx",
      "match": { "machineClass": "mini" },
      "backend": "mlx",
      "models": [
        {
          "id": "llama3.2:3b",
          "launch": {
            "engine": "mlx",
            "model": "meta-llama/Llama-3.2-3B-Instruct",
            "maxTokens": 4096
          }
        }
      ]
    },
    {
      "name": "mactower-mlx",
      "match": { "machineId": "mactower" },
      "backend": "mlx",
      "models": [
        {
          "id": "qwen3.6:35b-a3b",
          "launch": {
            "engine": "mlx",
            "model": "Qwen/Qwen3.5-35B-A3B",
            "maxTokens": 8192
          }
        }
      ]
    }
  ],
  "defaults": {
    "backend": "ollama",
    "port": 8080,
    "host": "0.0.0.0"
  }
}
